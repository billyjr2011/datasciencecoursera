# ─── Anthropic / Claude ──────────────────────────────────────────────────────
# Server-side only. NEVER expose this to the browser.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used for triage. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ndmed:ndmed@localhost:5432/ndmed?schema=public

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite, build-time) ─────────────────────────────────────────────
# Only VITE_* vars are exposed to the browser bundle. No secrets here.
VITE_API_BASE_URL=http://localhost:4000/api
